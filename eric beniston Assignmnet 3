      "source": "children[\"Age_Gender\"] = children[\"AgeInYearsAtScreening\"] * children[\"Gender_code\"]\n\nm_interaction = LinearRegression().fit(children[[\"AgeInYearsAtScreening\", \"Gender_code\", \"Age_Gender\"]], children[\"StandingHeightCm\"])",
