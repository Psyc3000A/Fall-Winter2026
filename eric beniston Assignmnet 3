    {
      "id": "a4c4e805-a907-4075-b1d7-87b88273efb0",
      "cell_type": "code",
      "source": "children[\"pred_interaction\"] = m_interaction.predict(children[[\"AgeInYearsAtScreening\", \"Gender_code\", \"Age_Gender\"]])\n\nmodels = {\n    \"1. Age only, no intercept\": (m_age, [\"AgeInYearsAtScreening\"]),\n    \"2. Age only, with intercept\": (m_age_const, [\"AgeInYearsAtScreening\"]),\n    \"3. Age + Gender\": (m_full, [\"AgeInYearsAtScreening\", \"Gender_code\"]),\n    \"4. Age × Gender\": (m_interaction, [\"AgeInYearsAtScreening\", \"Gender_code\", \"Age_Gender\"]),\n}\nrows = []\nfor name, (m, cols) in models.items():\n    rows.append({\"model\": name,\n                 \"intercept\": round(float(m.intercept_), 2),\n                 \"coefficients\": dict(zip(cols, m.coef_.round(2))),\n                 \"R2\": round(m.score(children[cols], children[\"StandingHeightCm\"]), 3)})\npd.DataFrame(rows)",
