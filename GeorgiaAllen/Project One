import pandas as pd

df = pd.read_csv("https://raw.githubusercontent.com/gc4113n/psych3000/main/rstudio-export/Study1Wave1.csv")
df["letter_yes"] = (df["letter"] == "Yes").astype(int)

summary = (
    df.groupby("treatment")[["donation_blm_1", "donation_unidos_1", "letter_yes"]]
      .agg(["count", "mean", "std"])
)

print(summary)

